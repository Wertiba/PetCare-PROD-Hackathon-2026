# Environment variable reference. Export these values before running the app.
# The app and Alembic read only the process environment; this file is not loaded.
# The test suite supplies its own defaults and does not require .env.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=petcare
DB_USER=postgres
DB_PASSWORD=change-me-please
DB_DRIVER=postgresql+asyncpg
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=10

APP_NAME=PetCare
# Used by `python -m app.run`. The production container listens on port 8000.
RUN_HOST=0.0.0.0
RUN_PORT=8080

# Secret used to sign JWTs - generate your own, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
APP_SECURITY_JWT_SECRET=change-me-please

# Format: <number><unit>, unit is one of s/m/h/d (e.g. "15m", "30d")
APP_SECURITY_ACCESS_TOKEN_EXPIRATION=15m
APP_SECURITY_REFRESH_TOKEN_EXPIRATION=30d
APP_SECURITY_PASSWORD_SCHEME=argon2
APP_SECURITY_ALGORITHM=HS256

# Admin account created by migration 0011; seeded animals and breeds belong to it.
# Must match frontend/src/shared/config/demo-users.ts (the quick-login button).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin12345
ADMIN_FULL_NAME=Администратор

# Secure flag on the refreshToken cookie. Set to `false` for local HTTP.
APP_COOKIE_SECURE=true

# Comma-separated list of origins allowed by CORS. Defaults to localhost if unset.
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8080

# RustFS photo storage (required in development and production).
# Internal S3 API origin used by the backend for uploads/deletions and by provisioning.
# Production Compose uses http://rustfs:9000.
S3_ENDPOINT_URL=http://localhost:9000
# Browser-reachable origin for signed downloads. No /media suffix; the bucket adds it.
# Production Compose uses https://<DOMAIN>. Signatures use this exact host.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# Private bucket; the production /media route requires this name to be media.
S3_BUCKET=media
# Request-signing region; must match the RustFS server's configured region.
S3_REGION=us-east-1
# Restricted application user's access key (not the storage administrator).
S3_ACCESS_KEY=
# Restricted application user's secret, also used to sign download URLs.
S3_SECRET_KEY=
# Signed download link lifetime in seconds; does not control how long photos are stored.
S3_PRESIGNED_TTL=604800
# Signed direct-upload link lifetime in seconds.
S3_UPLOAD_TTL=900

# Spirit LLM proxy for avatar generation. An empty API key disables generation.
LLM_PROXY_URL=https://llm-proxy.spirit.t-education.com
LLM_PROXY_API_KEY=
LLM_AVATAR_MODEL=openai/gpt-5.6-sol
LLM_IMAGE_TOOL_MODEL=gpt-image-1.5
LLM_AVATAR_TIMEOUT=180

# External reminders. The in-app status field is unchanged; delivered_at tracks Web Push.
# Dispatcher loop. Tests force this off. Several API processes may all run it.
NOTIFICATIONS_WORKER_ENABLED=true
NOTIFICATIONS_DISPATCH_INTERVAL=15
# Skip pending reminders older than this many seconds so a backlog is not sent at once.
NOTIFICATIONS_MAX_LATENESS=86400

# Web Push (VAPID). Generate with: uv run python scripts/generate_vapid_keys.py
# All three are required; otherwise Web Push endpoints answer 503.
# A non-empty subject must start with mailto: or https://.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Host suffixes of push services. A host matches a suffix or its subdomain.
WEB_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,push.services.mozilla.com,notify.windows.com,push.apple.com
# Seconds for one push HTTP request.
WEB_PUSH_TIMEOUT=10

# One JSON object per stdout line. Sage routing fields must match its naming rules.
LOG_CONSOLE_LEVEL=INFO
LOG_ENV=dev
LOG_SYSTEM=petcare
# Optional; defaults to the hostname (container ID in Docker).
# LOG_INST=petcare-01
