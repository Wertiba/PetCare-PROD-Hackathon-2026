[run]
source = app
branch = true
# SQLAlchemy's async engine runs queries in greenlets and TestClient runs the app in a worker thread;
# without both, every line after an `await` on the database is reported as missed.
concurrency = greenlet, thread
omit = */app/run.py

[report]
skip_empty = true
show_missing = true
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
exclude_also =
    class .*\(Protocol\):

