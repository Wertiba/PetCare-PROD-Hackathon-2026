{$DOMAIN} {
	redir /api /api/ 308

	handle /media/* {
		header X-Content-Type-Options nosniff # respect Content-Type, don't guess
		reverse_proxy rustfs:9000
	}

	@swagger path /docs /docs/* /openapi.json
	handle @swagger {
		reverse_proxy backend:8000
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
