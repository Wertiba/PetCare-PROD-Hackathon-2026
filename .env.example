DOMAIN=

FRONTEND_IMAGE=
BACKEND_IMAGE=
DB_PASSWORD=
APP_SECURITY_JWT_SECRET=

# Admin account created on the first migration. Must match frontend/src/shared/config/demo-users.ts
# (the "Войти как админ" quick-login button).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin12345

# Separate storage administrator and restricted photo application credentials.
RUSTFS_ROOT_ACCESS_KEY=
RUSTFS_ROOT_SECRET_KEY=
PHOTOS_ACCESS_KEY=
PHOTOS_SECRET_KEY=

# Optional: Web Push. Generate keys with `uv run python scripts/generate_vapid_keys.py` in backend/.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Backend structured logging; LOG_INST defaults to the container hostname.
LOG_ENV=prod
LOG_SYSTEM=petcare
LOG_CONSOLE_LEVEL=INFO
# LOG_INST=petcare-01

# In GitLab CI, set SAGE_GROUP and store the raw Spirit API key as masked/protected SAGE_API_KEY.
SAGE_GROUP=hack-led-15
SAGE_API_KEY=
